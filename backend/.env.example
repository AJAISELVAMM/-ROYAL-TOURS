# =============================================================================
# TourGuard AI — Backend environment template
# Copy to `.env` and fill in real values. NEVER commit a filled `.env`.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL for production) ---
# Production example: postgresql://USER:PASSWORD@HOST:5432/tourguard?schema=public
# Local dev fallback (SQLite) is auto-selected when DATABASE_URL is empty.
DATABASE_URL=

# --- Auth ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- CORS / frontend ---
FRONTEND_URL=http://localhost:5173

# --- SMS provider (optional — backend still starts without it) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Translation provider (Google Gemini) ---
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Geocoding & Maps Provider ---
# Options: photon (free, no key), nominatim (free, no key), openrouteservice, google
GEOCODING_PROVIDER=photon
GEOCODING_API_KEY=

# --- Routing Provider ---
# Options: openrouteservice, osrm (free, open data, no key), google
ROUTING_PROVIDER=openrouteservice
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- Geoapify Places & Location Intelligence ---
# Get your single API key from https://www.geoapify.com (3,000 free requests/day)
GEOAPIFY_API_KEY=

# --- Category-Specific Data Providers (Default: geoapify, fallback: overpass, local) ---
HOTEL_PROVIDER=geoapify
RESTAURANT_PROVIDER=geoapify
ATTRACTION_PROVIDER=geoapify
HOSPITAL_PROVIDER=geoapify
POLICE_PROVIDER=geoapify
EMERGENCY_PROVIDER=geoapify
TRANSPORT_PROVIDER=geoapify
TRANSIT_HUB_PROVIDER=geoapify
SHOPPING_PROVIDER=geoapify
ATM_PROVIDER=geoapify
PHARMACY_PROVIDER=geoapify
FUEL_PROVIDER=geoapify
GOV_OFFICE_PROVIDER=geoapify
FACILITY_PROVIDER=geoapify

# --- AI itinerary provider (optional) ---
AI_PROVIDER=
OPENAI_API_KEY=

# --- ML inference service (optional — serves the trained Random Forest models).
# When empty/unreachable, fare/safety prediction falls back to deterministic
# rule engines, so the app never depends on this being up.
ML_SERVICE_URL=http://localhost:8000

# --- Intelligence tuning (optional — defaults live in src/intelligence/config.js)
# FARE_FAIR_MAX_RATIO=1.10
# FARE_HIGH_MIN_RATIO=1.30
# SAFETY_W_INCIDENT=0.30

# --- Object storage for report photos (optional) ---
STORAGE_PROVIDER=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Initial admin (only read once by the seed script; hash is required) ---
ADMIN_EMAIL=admin@tourguard.ai
# bcrypt hash of the admin password. Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# --- Development-only external service mocking ---
# When true, SMS/maps/translation use in-process demo providers.
# MUST be false in production unless you have explicit confirmation.
MOCK_EXTERNAL_SERVICES=true

# --- Development-only mock GPS location (NEVER enable in production) ---
MOCK_LOCATION=true
